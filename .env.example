# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/franchise_quality_monitor
DATABASE_SSL=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=your-very-secure-jwt-secret-change-this-in-production
CLIENT_URL=http://localhost:5173

# ── AI Providers ──────────────────────────────────────────────────────────────
# Google AI Studio API Key (for Gemini 1.5 Pro video understanding)
GEMINI_API_KEY=your-google-ai-studio-api-key-here

# OpenAI API Key (for GPT-4o vision frame analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Optional: Redis for BullMQ (falls back to in-process queue if not set) ────
# REDIS_URL=redis://localhost:6379
