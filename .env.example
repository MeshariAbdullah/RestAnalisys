# ═══════════════════════════════════════════════════════════════════════════
#  Managed Luxury Rental Platform (MLR) — Saudi Arabia
#  Environment configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mlr_platform
DATABASE_SSL=false

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-in-production
CLIENT_URL=http://localhost:5173

# ── Platform identity (used when issuing Sanad as the creditor) ──────────────
PLATFORM_COMMERCIAL_ID=7000000000
PLATFORM_NAME="Managed Luxury Rental"

# ── Nafath (Saudi Digital Identity) ──────────────────────────────────────────
# Leave blank in development → service uses an auto-verify stub.
NAFATH_API_BASE=https://api.nafath.sa/v1
NAFATH_API_KEY=

# ── Nafith (Ministry of Justice — Sanad / promissory notes) ──────────────────
# Leave blank in development → service uses an auto-issue stub.
NAFITH_API_BASE=https://api.nafith.moj.gov.sa/v1
NAFITH_API_KEY=

# ── Payment gateway (HyperPay / Moyasar / PayTabs) ───────────────────────────
PAYMENT_GATEWAY=hyperpay
PAYMENT_GATEWAY_API_KEY=

# ── ZATCA e-invoicing ────────────────────────────────────────────────────────
ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa/e-invoicing/core
ZATCA_API_KEY=

# ── National Address (SPL) ───────────────────────────────────────────────────
SPL_API_KEY=

# ── Email / SMTP ────────────────────────────────────────────────────────────
# Leave blank in development → notifications are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@mlr.sa

# ── SMS Provider (Twilio / Unifonic) ────────────────────────────────────────
SMS_PROVIDER=
SMS_API_KEY=

# ── S3-compatible object storage (AWS S3 / MinIO / R2 / DO Spaces) ─────────
# Leave blank in development → files stored locally in /tmp/mlr-uploads.
S3_BUCKET=
S3_REGION=me-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
LOCAL_UPLOAD_DIR=/tmp/mlr-uploads
PUBLIC_URL_BASE=http://localhost:3001/uploads
