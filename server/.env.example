# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mlr_platform
DATABASE_SSL=false

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Nafath (Saudi Digital Identity) ───────────────────────────────────────────
# Leave blank for dev-mode stub
NAFATH_API_BASE=
NAFATH_API_KEY=

# ── Nafith (MOJ Promissory Notes) ────────────────────────────────────────────
# Leave blank for dev-mode stub
NAFITH_API_BASE=
NAFITH_API_KEY=

# ── Payment Gateway (HyperPay / Moyasar / PayTabs) ──────────────────────────
# Leave blank for dev-mode stub
PAYMENT_GATEWAY=hyperpay
PAYMENT_GATEWAY_API_KEY=

# ── ZATCA e-Invoicing ────────────────────────────────────────────────────────
# Leave blank for dev-mode stub
ZATCA_API_KEY=

# ── Platform Identity ────────────────────────────────────────────────────────
PLATFORM_COMMERCIAL_ID=
