# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mlr_platform
DATABASE_SSL=false

# ── Application ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-strong-random-secret

# ── Nafath Identity Verification ──────────────────────────────────────────────
# Leave empty to use dev-mode placeholder (auto-verifies)
NAFATH_API_BASE=
NAFATH_API_KEY=

# ── Nafith Sanad (MOJ Electronic Promissory Note) ────────────────────────────
# Leave empty to use dev-mode placeholder (auto-issues)
NAFITH_API_BASE=
NAFITH_API_KEY=

# ── Payment Gateway ──────────────────────────────────────────────────────────
# Leave empty to use dev-mode placeholder (auto-captures)
PAYMENT_GATEWAY=hyperpay
PAYMENT_GATEWAY_API_KEY=

# ── ZATCA E-Invoicing ────────────────────────────────────────────────────────
# Leave empty to use dev-mode placeholder (stub invoices)
ZATCA_API_KEY=

# ── Platform Identity ────────────────────────────────────────────────────────
PLATFORM_COMMERCIAL_ID=
