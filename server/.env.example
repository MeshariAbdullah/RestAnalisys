# ─────────────────────────────────────────────
# MLR Platform — Server Environment Variables
# ─────────────────────────────────────────────

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/mlr
JWT_SECRET=generate-a-strong-random-secret-here

# Optional — defaults shown
PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_SSL=false

# Platform config
PLATFORM_COMMERCIAL_ID=your-cr-number

# ─────────────────────────────────────────────
# Third-party integrations (all optional in dev)
# Leave unset to use dev-mode stubs.
# ─────────────────────────────────────────────

# Nafath (Saudi Digital ID)
# NAFATH_API_BASE=https://api.nafath.sa
# NAFATH_API_KEY=

# Nafith (Ministry of Justice — Sanad / promissory notes)
# NAFITH_API_BASE=https://api.nafith.sa
# NAFITH_API_KEY=

# Payment gateway (HyperPay / Moyasar / PayTabs)
# PAYMENT_GATEWAY=hyperpay
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_ENTITY_ID=

# ZATCA e-invoicing
# ZATCA_API_BASE=https://gw-fatoora.zatca.gov.sa
# ZATCA_API_KEY=

# National Address (Saudi Post — SPL)
# SPL_API_KEY=
